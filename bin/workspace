#!/usr/bin/env php
<?php
declare(strict_types=1);

namespace Workspace;

use Throwable;

require dirname(__DIR__).'/app/bootstrap.php';

function passwordInput(): string {
    $tty = stream_isatty(STDIN);
    if ($tty) {
        fwrite(STDERR,'Пароль (12–72 байта): ');
        if (PHP_OS_FAMILY !== 'Windows') {
            system('stty -echo', $code);
            if ($code !== 0) throw new Problem('Не удалось скрыть ввод. Передайте пароль через stdin.');
        } else {
            throw new Problem('Передайте пароль через stdin.');
        }
    }
    try {
        $line = fgets(STDIN);
        if ($line === false) throw new Problem('Пароль не получен через stdin.');
        return rtrim($line,"\r\n");
    } finally {
        if ($tty) { system('stty echo'); fwrite(STDERR,"\n"); }
    }
}

function helpText(): string {
    return <<<HELP
CajeerWorkspace PHP 0.7.3

  php bin/workspace init EMAIL "Имя владельца"
  php bin/workspace user:add EMAIL "Имя" ROLE
  php bin/workspace user:password EMAIL
  php bin/workspace user:disable EMAIL
  php bin/workspace user:enable EMAIL
  php bin/workspace auth:check
  php bin/workspace auth:bind EMAIL SUBJECT
  php bin/workspace auth:unbind EMAIL
  php bin/workspace auth:emergency EMAIL on|off
  php bin/workspace auth:mfa-reset EMAIL
  php bin/workspace retention:preview ORG_ID OWNER_ID [LIMIT]
  php bin/workspace retention:cleanup ORG_ID OWNER_ID [LIMIT]
  php bin/workspace retention:objects ORG_ID OWNER_ID [LIMIT] [MIN_BYTES]
  php bin/workspace doctor
  php bin/workspace upgrade [/абсолютный/путь/к/копии.sqlite]
  php bin/workspace migrations
  php bin/workspace sync [подключение]
  php bin/workspace profile [--check]
  php bin/workspace protocol ПОДКЛЮЧЕНИЕ [BEFORE_ID]
  php bin/workspace backup /полный/путь/к/новой-копии.sqlite
  php bin/workspace postgres:import /абсолютный/путь/к/копии.sqlite
  php bin/workspace connection:assign KEY ORG_ID
  php bin/workspace github:bind PROJECT_ID INSTALLATION_ID REPOSITORY_ID
  php bin/workspace github:sync [PROJECT_ID]
  php bin/workspace github:work [LIMIT]
  php bin/workspace github:check
  php bin/workspace infra:sync HOST_ID OWNER_ID
  php bin/workspace deploy:target SITE_ID
  php bin/workspace deploy:pending SITE_ID
  php bin/workspace deploy:tick SITE_ID
  php bin/workspace deploy:work DEPLOYMENT_ID
  php bin/workspace deploy:recover DEPLOYMENT_ID
  php bin/workspace sign:tick [LIMIT]
  php bin/workspace lite:inspect SITE_ID OWNER_ID
  php bin/workspace lite:work JOB_ID
  php bin/workspace lite:restore JOB_ID --offline
  php bin/workspace lite:reconcile JOB_ID [--offline]
  php bin/workspace version

Роли: owner, manager, developer, accountant, legal, viewer.
Пароли принимаются через stdin. В интерактивном Unix-терминале ввод скрыт.

HELP;
}

try {
    $command = $argv[1] ?? 'help';
    if ($command === 'help' || $command === '--help') { echo helpText(); exit(0); }
    if ($command === 'version') { echo VERSION,PHP_EOL; exit(0); }
    if ($command === 'init') {
        if ($argc !== 4) throw new Problem('Формат: init EMAIL "Имя"');
        $db = database(true);
        addUser($db,$argv[2],$argv[3],'owner',passwordInput(),true);
        echo "Владелец создан. Можно войти в Workspace.\n";
        exit(0);
    }
    if ($command === 'doctor') {
        if ($argc !== 2) throw new Problem('Формат: doctor');
        $report=runtimeReport();
        echo json_encode($report,JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT),PHP_EOL;
        exit($report['ok']?0:1);
    }
    if ($command==='auth:check') {
        if ($argc!==2) throw new Problem('Формат: auth:check');
        authKey();
        if (oidcEnabled()) { $cfg=oidcConfig(); oidcDiscovery(); echo json_encode(['mode'=>'oidc','issuer'=>ID_ISSUER,'redirect_uri'=>$cfg['callback'],'post_logout_redirect_uri'=>$cfg['logout'],'mfa_key'=>'configured'],JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT),PHP_EOL; }
        else echo "Local mode; MFA key configured.\n";
        exit(0);
    }
    if ($command==='postgres:import') {
        if ($argc!==3) throw new Problem('Формат: postgres:import /абсолютный/путь/к/копии.sqlite');
        echo json_encode(migrateToPostgres($argv[2]),JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES),PHP_EOL; exit(0);
    }
    if ($command === 'upgrade') {
        if ($argc > 3) throw new Problem('Формат: upgrade [абсолютный путь копии]');
        if (postgresSelected() && $argc!==2) throw new Problem('Для PostgreSQL создайте проверенный pg_dump отдельно и выполните upgrade без пути SQLite.');
        database(false,true,$argv[2]??null,static function(array $backup) {
            echo 'Предварительная копия: ',json_encode($backup,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE),PHP_EOL;
            fflush(STDOUT);
        });
        echo "Схема данных обновлена до ".SCHEMA_VERSION.".\n";
        exit(0);
    }
    if ($command === 'backup') {
        if ($argc !== 3) throw new Problem('Укажите абсолютный путь для новой копии.');
        $db=openDatabase();
        $backup=snapshotDatabase($db,$argv[2]);
        echo json_encode($backup,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE),PHP_EOL;
        exit(0);
    }
    if ($command === 'migrations') {
        if ($argc !== 2) throw new Problem('Формат: migrations');
        $db=openDatabase();
        $version=schemaVersion($db);
        $files=migrationFiles($db);
        if ($version<1 || $version>SCHEMA_VERSION) throw new Problem('Несовместимая версия схемы.',503);
        validateLedger($db,$version,$files);
        $rows=$version>=3?$db->query('SELECT * FROM schema_migrations ORDER BY version')->fetchAll():[];
        echo json_encode(['current'=>$version,'target'=>SCHEMA_VERSION,'pending'=>array_values(array_filter(array_keys($files),static fn($v)=>$v>$version)),'history'=>$rows],JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT),PHP_EOL;
        exit(0);
    }
    if ($command==='github:check') {
        if ($argc!==2) throw new Problem('Формат: github:check');
        ghSecret(); GitHubApp::configured(); echo "GitHub App configuration loaded. Verify installation with github:bind.\n"; exit(0);
    }
    $db = database();
    switch ($command) {
        case 'lite:inspect': case 'lite:work': case 'lite:restore': case 'lite:reconcile':
            require ROOT.'/app/LiteWorker.php';
            $offline=($argv[3]??'')==='--offline';
            if($command==='lite:inspect'){if($argc!==4)throw new Problem('Формат: lite:inspect SITE_ID OWNER_ID');$report=liteInspect($db,numberId($argv[2]),numberId($argv[3]));}
            elseif($command==='lite:work'){if($argc!==3)throw new Problem('Формат: lite:work JOB_ID');$report=litePublish($db,numberId($argv[2]));}
            elseif($command==='lite:restore'){if($argc!==4||!$offline)throw new Problem('Формат: lite:restore JOB_ID --offline');$report=liteRestore($db,numberId($argv[2]),true);}
            else {if($argc!==3&&($argc!==4||!$offline))throw new Problem('Формат: lite:reconcile JOB_ID [--offline]');$report=liteReconcile($db,numberId($argv[2]),$offline);}
            echo json_encode($report,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT),PHP_EOL;
            exit(!isset($report['state'])||in_array($report['state'],['published','restored','aborted'],true)?0:1);
        case 'retention:preview': case 'retention:cleanup': case 'retention:objects':
            if($argc<4||$argc>($command==='retention:objects'?6:5))throw new Problem('Формат: retention:MODE ORG_ID OWNER_ID [LIMIT] [MIN_BYTES]');
            echo signJson(retentionBatch($db,['id'=>numberId($argv[3]),'organization_id'=>numberId($argv[2])],substr($command,10),isset($argv[4])?numberId($argv[4]):100,isset($argv[5])?numberId($argv[5]):1048576)),PHP_EOL;break;
        case 'sign:tick':
            if($argc>3)throw new Problem('Формат: sign:tick [LIMIT]');echo signJson(signTick($db,signConfig(),$argc===3?numberId($argv[2]):10)),PHP_EOL;break;
        case 'deploy:target':
            if($argc!==3)throw new Problem('Формат: deploy:target SITE_ID');
            $site=entity($db,'SELECT * FROM infra_sites WHERE id=?',[numberId($argv[2])]);
            echo json_encode(deploymentIdentity($db,(int)$site['project_id'],(int)$site['id'],(int)$site['organization_id']),JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES),PHP_EOL; break;
        case 'deploy:tick':
            if($argc!==3)throw new Problem('Формат: deploy:tick SITE_ID');
            $id=query($db,"SELECT id FROM deployments WHERE site_id=? AND state='queued' AND window_start<=? ORDER BY id LIMIT 1",[numberId($argv[2]),time()])->fetchColumn();
            if($id===false){echo "No queued deployment ready.\n";break;}
            $result=deploymentRun($db,(int)$id);echo json_encode($result,JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE),PHP_EOL;exit($result['state']==='succeeded'?0:1);
        case 'deploy:pending':
            if($argc!==3)throw new Problem('Формат: deploy:pending SITE_ID');
            $site=numberId($argv[2]);
            echo json_encode(query($db,"SELECT id,site_id,state,window_start,window_end FROM deployments WHERE site_id=? AND state IN ('queued','running','recovery_required') ORDER BY id",[$site])->fetchAll(),JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT),PHP_EOL; break;
        case 'deploy:work': case 'deploy:recover':
            if($argc!==3)throw new Problem('Формат: deploy:work|deploy:recover DEPLOYMENT_ID');
            $result=deploymentRun($db,numberId($argv[2]),$command==='deploy:recover');
            echo json_encode($result,JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE),PHP_EOL; exit($result['state']==='succeeded'?0:1);
        case 'infra:sync':
            if($argc!==4) throw new Problem('Формат: infra:sync HOST_ID OWNER_ID');
            $hid=numberId($argv[2]); $host=entity($db,'SELECT organization_id FROM infra_hosts WHERE id=?',[$hid]);
            $actor=entity($db,"SELECT u.id,u.session_version,m.organization_id FROM users u JOIN organization_members m ON m.user_id=u.id WHERE m.organization_id=? AND m.role='owner' AND u.enabled=1 AND u.id=?",[$host['organization_id'],numberId($argv[3])]);
            $obs=infraSync($db,$actor,$hid,null,true); $failed=false; foreach($obs as $source=>$o){echo $source,': ',($o['error']===''?'OK':$o['error']),PHP_EOL; if($o['error']!=='')$failed=true;} exit($failed?1:0);
        case 'github:bind':
            if ($argc!==5) throw new Problem('Формат: github:bind PROJECT_ID INSTALLATION_ID REPOSITORY_ID');
            echo 'Binding: ',ghBind($db,GitHubApp::configured(),ghId($argv[2]),ghId($argv[3]),ghId($argv[4])),PHP_EOL; break;
        case 'github:sync':
            if ($argc>3) throw new Problem('Формат: github:sync [PROJECT_ID]');
            echo 'Repositories queued: ',ghManual($db,isset($argv[2])?ghId($argv[2]):null),PHP_EOL; break;
        case 'github:work':
            if ($argc>3) throw new Problem('Формат: github:work [LIMIT]');
            $results=ghWork($db,GitHubApp::configured(),isset($argv[2])?ghId($argv[2]):10);
            echo json_encode($results,JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT),PHP_EOL;
            exit(in_array('dead',array_column($results,'state'),true)?1:0);

        case 'auth:bind': case 'auth:unbind': case 'auth:emergency': case 'auth:mfa-reset':
            $needed=in_array($command,['auth:bind','auth:emergency'],true)?4:3;
            if ($argc!==$needed) throw new Problem('Проверьте формат команды auth (help).');
            $email=normalizedEmail($argv[2]);
            atomic($db,function() use($db,$email,$command,$argv) {
                $u=entity($db,'SELECT id,enabled FROM users WHERE LOWER(email)=?',[$email]); $uid=(int)$u['id'];
                if ($command==='auth:bind') {
                    $sub=word($argv[3],255,'OIDC subject');
                    if (query($db,'SELECT 1 FROM oidc_identities WHERE user_id=? OR (issuer=? AND subject=?)',[$uid,ID_ISSUER,$sub])->fetchColumn() || query($db,'SELECT 1 FROM guest_invites WHERE issuer=? AND subject=? AND revoked_at IS NULL AND access_until>?',[ID_ISSUER,$sub,time()])->fetchColumn()) throw new Problem('Привязка уже существует или subject принадлежит гостю. Сначала отзовите прежний доступ.',409);
                    query($db,'INSERT INTO oidc_identities(user_id,issuer,subject) VALUES(?,?,?)',[$uid,ID_ISSUER,$sub]);
                } elseif ($command==='auth:unbind') {
                    query($db,'DELETE FROM oidc_identities WHERE user_id=?',[$uid]);
                } elseif ($command==='auth:emergency') {
                    if (!in_array($argv[3],['on','off'],true)) throw new Problem('Укажите on или off.');
                    if ($argv[3]==='on') {
                        if (!$u['enabled']||!query($db,"SELECT 1 FROM organization_members WHERE user_id=? AND role='owner'",[$uid])->fetchColumn()||!query($db,'SELECT 1 FROM mfa_credentials WHERE user_id=?',[$uid])->fetchColumn()) throw new Problem('Нужен активный владелец с подключённым TOTP.');
                        query($db,'INSERT INTO emergency_accounts(user_id) VALUES(?) ON CONFLICT DO NOTHING',[$uid]);
                    } else query($db,'DELETE FROM emergency_accounts WHERE user_id=?',[$uid]);
                } else {
                    if (query($db,'SELECT 1 FROM emergency_accounts WHERE user_id=?',[$uid])->fetchColumn()) throw new Problem('Сначала отключите аварийный доступ.');
                    query($db,'DELETE FROM mfa_credentials WHERE user_id=?',[$uid]);
                }
                query($db,'UPDATE users SET session_version=session_version+1 WHERE id=?',[$uid]);
                query($db,'UPDATE oidc_sessions SET revoked_at=? WHERE user_id=? AND revoked_at IS NULL',[time(),$uid]);
            });
            echo "Настройки авторизации обновлены; прежние сессии отозваны.\n"; break;
        case 'connection:assign':
            if ($argc!==4) throw new Problem('Формат: connection:assign KEY ORG_ID');
            $key=word($argv[2],48,'Подключение'); $org=numberId($argv[3]);
            if (!isset(connections()[$key])) throw new Problem('Подключение отсутствует в конфигурации.');
            atomic($db,function() use($db,$key,$org) {
                entity($db,'SELECT id FROM organizations WHERE id=?',[$org]);
                foreach (($org===1?['organization_connections']:['organization_connections','project_connections','connection_results','connection_checks']) as $table) {
                    if (query($db,"SELECT 1 FROM $table WHERE connection_key=? LIMIT 1",[$key])->fetchColumn()) throw new Problem('Использованный ключ нельзя передать другой организации. Создайте новый ключ.',409);
                }
                query($db,'INSERT INTO organization_connections VALUES(?,?)',[$key,$org]);
            });
            echo "Подключение назначено.\n"; break;
        case 'user:add':
            if ($argc !== 5) throw new Problem('Формат: user:add EMAIL "Имя" ROLE');
            addUser($db,$argv[2],$argv[3],$argv[4],passwordInput());
            echo "Пользователь создан.\n";
            break;
        case 'user:password':
        case 'user:disable':
        case 'user:enable':
            if ($argc !== 3) throw new Problem('Укажите email пользователя.');
            $email = normalizedEmail($argv[2]);
            $hash = $command === 'user:password' ? passwordHash(passwordInput()) : null;
            atomic($db, static function () use ($db,$email,$command,$hash) {
                $u = entity($db,'SELECT id,role,enabled FROM users WHERE LOWER(email)=?',[$email]);
                if ($command === 'user:disable' && $u['enabled'] && query($db,"SELECT 1 FROM organization_members m WHERE m.user_id=? AND m.role='owner' AND NOT EXISTS (SELECT 1 FROM organization_members n JOIN users a ON a.id=n.user_id WHERE n.organization_id=m.organization_id AND n.role='owner' AND a.enabled=1 AND n.user_id<>m.user_id)",[$u['id']])->fetchColumn()) {
                    throw new Problem('В пространстве должен оставаться активный владелец.');
                }
                if ($hash !== null) query($db,'UPDATE users SET password_hash=?,session_version=session_version+1 WHERE id=?',[$hash,$u['id']]);
                else query($db,'UPDATE users SET enabled=?,session_version=session_version+1 WHERE id=?',[(int)($command==='user:enable'),$u['id']]);
            });
            echo "Учётная запись обновлена.\n";
            break;
        case 'sync':
            if ($argc > 3) throw new Problem('Формат: sync [подключение]');
            $items = connections();
            if ((int)$db->query('SELECT COUNT(*) FROM organizations')->fetchColumn()>1) {
                $assigned=$db->query('SELECT connection_key FROM organization_connections')->fetchAll(\PDO::FETCH_COLUMN);
                $items=array_intersect_key($items,array_flip($assigned));
            }
            if (isset($argv[2])) {
                $id = $argv[2];
                if (!isset($items[$id]) || !$items[$id]['configured']) throw new Problem('Подключение отсутствует или не настроено.');
                $items = [$id=>$items[$id]];
            }
            $lock = fopen(dataDir().'/sync.lock','c');
            if (!$lock || !flock($lock,LOCK_EX|LOCK_NB)) throw new Problem('Другой процесс уже проверяет подключения.');
            try { $failed = syncConnections($db,$items); }
            finally { flock($lock,LOCK_UN); fclose($lock); }
            exit($failed ? 1 : 0);
        case 'profile':
            if ($argc > 3 || ($argc === 3 && $argv[2] !== '--check')) throw new Problem('Формат: profile [--check]');
            $report=profileReport($db);
            echo json_encode($report,JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT),PHP_EOL;
            exit($argc===3 && $report['issues']!==[] ? 1 : 0);
        case 'protocol':
            if ($argc < 3 || $argc > 4 || !preg_match('/\A[a-z][a-z0-9_-]{0,47}\z/',$argv[2])) throw new Problem('Формат: protocol ПОДКЛЮЧЕНИЕ [BEFORE_ID]');
            $before=isset($argv[3])?numberId($argv[3]):null;
            $rows=connectionHistory($db,$argv[2],$before,51);
            if (!isset(connections()[$argv[2]]) && !$rows && !query($db,'SELECT 1 FROM connection_checks WHERE connection_key=? LIMIT 1',[$argv[2]])->fetchColumn()) throw new Problem('Подключение не найдено.');
            $more=count($rows)>50;
            $rows=array_slice($rows,0,50);
            foreach ($rows as &$row) unset($row['target_hash']);
            unset($row);
            echo json_encode(['connection'=>$argv[2],'next_before'=>$more?(int)$rows[49]['id']:null,'checks'=>$rows],JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT),PHP_EOL;
            break;
        default:
            fwrite(STDERR,helpText()); exit(2);
    }
} catch (Throwable $e) {
    fwrite(STDERR,'Ошибка: '.($e instanceof Problem || $e instanceof \RuntimeException && !$e instanceof \PDOException ? $e->getMessage() : 'Проверьте установку PHP, расширения и права каталога.').PHP_EOL);
    exit(2);
}
