#!/usr/bin/env php
<?php
declare(strict_types=1);

namespace Workspace;

use Throwable;

require dirname(__DIR__).'/app/bootstrap.php';

function passwordInput(): string {
    $tty = stream_isatty(STDIN);
    if ($tty) {
        fwrite(STDERR,'Пароль (12–72 байта): ');
        if (PHP_OS_FAMILY !== 'Windows') {
            system('stty -echo', $code);
            if ($code !== 0) throw new Problem('Не удалось скрыть ввод. Передайте пароль через stdin.');
        } else {
            throw new Problem('Передайте пароль через stdin.');
        }
    }
    try {
        $line = fgets(STDIN);
        if ($line === false) throw new Problem('Пароль не получен через stdin.');
        return rtrim($line,"\r\n");
    } finally {
        if ($tty) { system('stty echo'); fwrite(STDERR,"\n"); }
    }
}

function helpText(): string {
    return <<<HELP
CajeerWorkspace PHP 0.2.0

  php bin/workspace init EMAIL "Имя владельца"
  php bin/workspace user:add EMAIL "Имя" ROLE
  php bin/workspace user:password EMAIL
  php bin/workspace user:disable EMAIL
  php bin/workspace user:enable EMAIL
  php bin/workspace doctor
  php bin/workspace upgrade [/абсолютный/путь/к/копии.sqlite]
  php bin/workspace migrations
  php bin/workspace sync [подключение]
  php bin/workspace profile [--check]
  php bin/workspace protocol ПОДКЛЮЧЕНИЕ [BEFORE_ID]
  php bin/workspace backup /полный/путь/к/новой-копии.sqlite
  php bin/workspace postgres:import /абсолютный/путь/к/копии.sqlite
  php bin/workspace connection:assign KEY ORG_ID
  php bin/workspace version

Роли: owner, manager, developer, accountant, legal, viewer.
Пароли принимаются через stdin. В интерактивном Unix-терминале ввод скрыт.

HELP;
}

try {
    $command = $argv[1] ?? 'help';
    if ($command === 'help' || $command === '--help') { echo helpText(); exit(0); }
    if ($command === 'version') { echo VERSION,PHP_EOL; exit(0); }
    if ($command === 'init') {
        if ($argc !== 4) throw new Problem('Формат: init EMAIL "Имя"');
        $db = database(true);
        addUser($db,$argv[2],$argv[3],'owner',passwordInput(),true);
        echo "Владелец создан. Можно войти в Workspace.\n";
        exit(0);
    }
    if ($command === 'doctor') {
        if ($argc !== 2) throw new Problem('Формат: doctor');
        $report=runtimeReport();
        echo json_encode($report,JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT),PHP_EOL;
        exit($report['ok']?0:1);
    }
    if ($command==='postgres:import') {
        if ($argc!==3) throw new Problem('Формат: postgres:import /абсолютный/путь/к/копии.sqlite');
        echo json_encode(migrateToPostgres($argv[2]),JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES),PHP_EOL; exit(0);
    }
    if ($command === 'upgrade') {
        if ($argc > 3) throw new Problem('Формат: upgrade [абсолютный путь копии]');
        database(false,true,$argv[2]??null,static function(array $backup) {
            echo 'Предварительная копия: ',json_encode($backup,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE),PHP_EOL;
            fflush(STDOUT);
        });
        echo "Схема данных обновлена до ".SCHEMA_VERSION.".\n";
        exit(0);
    }
    if ($command === 'backup') {
        if ($argc !== 3) throw new Problem('Укажите абсолютный путь для новой копии.');
        $db=openDatabase();
        $backup=snapshotDatabase($db,$argv[2]);
        echo json_encode($backup,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE),PHP_EOL;
        exit(0);
    }
    if ($command === 'migrations') {
        if ($argc !== 2) throw new Problem('Формат: migrations');
        $db=openDatabase();
        $version=schemaVersion($db);
        $files=migrationFiles($db);
        if ($version<1 || $version>SCHEMA_VERSION) throw new Problem('Несовместимая версия схемы.',503);
        validateLedger($db,$version,$files);
        $rows=$version>=3?$db->query('SELECT * FROM schema_migrations ORDER BY version')->fetchAll():[];
        echo json_encode(['current'=>$version,'target'=>SCHEMA_VERSION,'pending'=>array_values(array_filter(array_keys($files),static fn($v)=>$v>$version)),'history'=>$rows],JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT),PHP_EOL;
        exit(0);
    }
    $db = database();
    switch ($command) {
        case 'connection:assign':
            if ($argc!==4) throw new Problem('Формат: connection:assign KEY ORG_ID');
            $key=word($argv[2],48,'Подключение'); $org=numberId($argv[3]);
            if (!isset(connections()[$key])) throw new Problem('Подключение отсутствует в конфигурации.');
            atomic($db,function() use($db,$key,$org) {
                entity($db,'SELECT id FROM organizations WHERE id=?',[$org]);
                foreach (($org===1?['organization_connections']:['organization_connections','project_connections','connection_results','connection_checks']) as $table) {
                    if (query($db,"SELECT 1 FROM $table WHERE connection_key=? LIMIT 1",[$key])->fetchColumn()) throw new Problem('Использованный ключ нельзя передать другой организации. Создайте новый ключ.',409);
                }
                query($db,'INSERT INTO organization_connections VALUES(?,?)',[$key,$org]);
            });
            echo "Подключение назначено.\n"; break;
        case 'user:add':
            if ($argc !== 5) throw new Problem('Формат: user:add EMAIL "Имя" ROLE');
            addUser($db,$argv[2],$argv[3],$argv[4],passwordInput());
            echo "Пользователь создан.\n";
            break;
        case 'user:password':
        case 'user:disable':
        case 'user:enable':
            if ($argc !== 3) throw new Problem('Укажите email пользователя.');
            $email = normalizedEmail($argv[2]);
            $hash = $command === 'user:password' ? passwordHash(passwordInput()) : null;
            atomic($db, static function () use ($db,$email,$command,$hash) {
                $u = entity($db,'SELECT id,role,enabled FROM users WHERE LOWER(email)=?',[$email]);
                if ($command === 'user:disable' && $u['enabled'] && query($db,"SELECT 1 FROM organization_members m WHERE m.user_id=? AND m.role='owner' AND NOT EXISTS (SELECT 1 FROM organization_members n JOIN users a ON a.id=n.user_id WHERE n.organization_id=m.organization_id AND n.role='owner' AND a.enabled=1 AND n.user_id<>m.user_id)",[$u['id']])->fetchColumn()) {
                    throw new Problem('В пространстве должен оставаться активный владелец.');
                }
                if ($hash !== null) query($db,'UPDATE users SET password_hash=?,session_version=session_version+1 WHERE id=?',[$hash,$u['id']]);
                else query($db,'UPDATE users SET enabled=?,session_version=session_version+1 WHERE id=?',[(int)($command==='user:enable'),$u['id']]);
            });
            echo "Учётная запись обновлена.\n";
            break;
        case 'sync':
            if ($argc > 3) throw new Problem('Формат: sync [подключение]');
            $items = connections();
            if ((int)$db->query('SELECT COUNT(*) FROM organizations')->fetchColumn()>1) {
                $assigned=$db->query('SELECT connection_key FROM organization_connections')->fetchAll(\PDO::FETCH_COLUMN);
                $items=array_intersect_key($items,array_flip($assigned));
            }
            if (isset($argv[2])) {
                $id = $argv[2];
                if (!isset($items[$id]) || !$items[$id]['configured']) throw new Problem('Подключение отсутствует или не настроено.');
                $items = [$id=>$items[$id]];
            }
            $lock = fopen(dataDir().'/sync.lock','c');
            if (!$lock || !flock($lock,LOCK_EX|LOCK_NB)) throw new Problem('Другой процесс уже проверяет подключения.');
            try { $failed = syncConnections($db,$items); }
            finally { flock($lock,LOCK_UN); fclose($lock); }
            exit($failed ? 1 : 0);
        case 'profile':
            if ($argc > 3 || ($argc === 3 && $argv[2] !== '--check')) throw new Problem('Формат: profile [--check]');
            $report=profileReport($db);
            echo json_encode($report,JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT),PHP_EOL;
            exit($argc===3 && $report['issues']!==[] ? 1 : 0);
        case 'protocol':
            if ($argc < 3 || $argc > 4 || !preg_match('/\A[a-z][a-z0-9_-]{0,47}\z/',$argv[2])) throw new Problem('Формат: protocol ПОДКЛЮЧЕНИЕ [BEFORE_ID]');
            $before=isset($argv[3])?numberId($argv[3]):null;
            $rows=connectionHistory($db,$argv[2],$before,51);
            if (!isset(connections()[$argv[2]]) && !$rows && !query($db,'SELECT 1 FROM connection_checks WHERE connection_key=? LIMIT 1',[$argv[2]])->fetchColumn()) throw new Problem('Подключение не найдено.');
            $more=count($rows)>50;
            $rows=array_slice($rows,0,50);
            foreach ($rows as &$row) unset($row['target_hash']);
            unset($row);
            echo json_encode(['connection'=>$argv[2],'next_before'=>$more?(int)$rows[49]['id']:null,'checks'=>$rows],JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT),PHP_EOL;
            break;
        default:
            fwrite(STDERR,helpText()); exit(2);
    }
} catch (Throwable $e) {
    fwrite(STDERR,'Ошибка: '.($e instanceof Problem || $e instanceof \RuntimeException && !$e instanceof \PDOException ? $e->getMessage() : 'Проверьте установку PHP, расширения и права каталога.').PHP_EOL);
    exit(2);
}
